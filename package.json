{
  "name": "whale-class-presenter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build && node scripts/verify-build.mjs",
    "check:skills": "node scripts/verify-skills.mjs",
    "check:materials": "node scripts/inventory-test-materials.mjs test-materials",
    "check": "npm run check:skills && npm run check:materials && npm test && npm run build",
    "licenses": "node scripts/list-licenses.mjs"
  },
  "dependencies": {
    "@web-ppt/core": "0.4.5",
    "@web-ppt/viewer-core": "0.4.5",
    "lucide-react": "1.55.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "0.3.4",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.5",
    "fflate": "0.8.3",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
